{
  "mcpServers": {
    "context7": {
      "command": "/home/o/.local/bin/context7-mcp"
    },
    "chrome-devtools": {
      "command": "/home/o/.local/bin/chrome-devtools-mcp",
      "args": ["--no-usage-statistics"]
    },
    "codegraph": {
      "type": "stdio",
      "command": "/home/o/.local/bin/codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ]
    },
    "agentmemory": {
      "command": "/home/o/.local/bin/agentmemory-mcp",
      "env": {
        "AGENTMEMORY_URL": "http://127.0.0.1:3111",
        "AGENTMEMORY_FORCE_PROXY": "1",
        "AGENTMEMORY_TOOLS": "all"
      }
    }
  }
}
