{
  "manifest_version": 3,
  "name": "Platform Signals",
  "version": "0.7.0",
  "description": "Сигналы ботов: сеть, фильтр, звук, маркеры CALL/PUT на графике Pocket Option.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*/*",
    "*://pocketoption.com/*",
    "*://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "float.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Platform Signals"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pocketoption.com/*",
        "*://*.pocketoption.com/*"
      ],
      "js": ["content/po-open-asset.js", "content/po-chart-overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
