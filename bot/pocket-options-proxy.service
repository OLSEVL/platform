[Unit]
Description=Pocket Options Proxy (HTTP API + ingest candles to platform)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/o/platform/bot
EnvironmentFile=/home/o/platform/bot/proxy.env
# Явный интерпретатор venv (не полагаемся на shebang у скриптов в .venv/bin)
ExecStart=/home/o/platform/bot/.venv/bin/python /home/o/platform/bot/pocket-options-proxy.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pocket-options-proxy

[Install]
WantedBy=multi-user.target
