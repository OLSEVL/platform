# Переменные для systemd-сервиса pocket-options-proxy.
# URL Laravel с того же хоста, что и прокси (curl должен отдавать 200 на /api/proxy/instruments).
PLATFORM_URL=http://127.0.0.1:8080
INGEST_USE_API_CANDLES=1
INGEST_CURRENT_CANDLE_ENABLE=1
INGEST_CURRENT_CANDLE_TTL_SEC=180
# Более частая отправка partial-свечи → живее S5 на chart-live (цель ~4 Hz на активной паре).
# Без снижения INGEST_LOOP_INTERVAL_SEC debounce ниже 1s бесполезен: цикл будит POST только раз в loop.
INGEST_CURRENT_CANDLE_POST_DEBOUNCE_SEC=0.25
# Писать partial в Redis напрямую (не через PHP-FPM): иначе 114×4 Hz → 504 при pm.max_children=5.
INGEST_CURRENT_CANDLE_REDIS_DIRECT=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=laravel-database-
# Явно фиксируем базовый поток свечей как S5 (чтобы не зависеть от дефолтов кода).
INGEST_BASE_BAR_SECONDS=5
INGEST_BASE_TIMEFRAME_ID=4005
# Коррекция времени feed (сек): отрицательное значение сдвигает свечи назад.
# Пример для текущего кейса (+~2h в feed): -7200
FEED_TIME_CORRECTION_SEC=-7200
# TIME-лог на каждый тик × все пары раздувает proxy.log до десятков ГБ
# и роняет ingest (OSError 28 No space left). Включать только для короткой диагностики.
FEED_TIME_DELTA_LOG_ENABLE=0
# Не писать flush_detail на каждую свечу — иначе лог снова растёт слишком быстро.
INGEST_FLUSH_DETAIL=0
# Частота цикла инжеста (сек). Должна быть <= debounce, иначе POST не чаще loop.
INGEST_LOOP_INTERVAL_SEC=0.25
# Частота обновления списка инструментов/конфигов воркеров (в т.ч. подхват смены прокси).
INSTRUMENTS_REFRESH_SEC=30
# Сколько одновременных WS-воркеров держит ingest.
# Должно быть >= числа активных инструментов в /instruments, иначе «хвост»
# списка (после сортировки по priority) вообще не получает стрим —
# замена прокси у таких пар выглядит как «не работает».
# Запас на рост списка (валюты + крипта + акции OTC).
INGEST_MAX_CONNECTIONS=200
