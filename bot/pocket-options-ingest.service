[Unit]
Description=Pocket Options Ingest (one WebSocket per instrument)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/o/platform/bot
EnvironmentFile=/home/o/platform/bot/proxy.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/o/platform/bot/.venv/bin/python -c "import asyncio, ingest_stream; asyncio.run(ingest_stream.run_ingest_forever())"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pocket-options-ingest

[Install]
WantedBy=multi-user.target
