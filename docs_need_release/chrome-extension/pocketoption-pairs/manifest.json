{
  "manifest_version": 3,
  "name": "PocketOption — активы (пары)",
  "version": "1.2.2",
  "description": "Горячие клавиши Alt+Q / Alt+W для переключения активов (Валюты, Криптовалюты, Акции) на pocketoption.com",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "pair-prev": {
      "suggested_key": {
        "default": "Alt+Q",
        "windows": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Предыдущая валютная пара (вверх по списку)"
    },
    "pair-next": {
      "suggested_key": {
        "default": "Alt+W",
        "windows": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Следующая валютная пара (вниз по списку)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "PocketOption Pairs",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
